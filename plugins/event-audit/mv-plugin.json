{
  "manifest_version": 1,
  "id": "event_audit",
  "name": "事件审计示例",
  "version": "1.0.1",
  "description": "演示声明式配置页、测试 action 和定时任务",
  "runtime": "python3-stdlib",
  "entrypoint": "runner/main.py",
  "events": [
    "media.uploaded", "media.upload_failed", "media.upload_skipped",
    "strm.generated", "strm.failed", "library.sync_completed", "library.sync_failed",
    "organize.completed", "organize.failed", "subscription.completed", "subscription.failed",
    "download.completed", "download.failed", "backup.completed", "backup.failed", "webhook.received"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "label": {"type": "string", "maxLength": 80},
      "mode": {"type": "string", "enum": ["compact", "detailed"]}
    },
    "additionalProperties": false
  },
  "actions": {
    "preview": {"title": "预览协议", "input_schema": {"type": "object", "additionalProperties": false}}
  },
  "schedules": [
    {"id": "hourly_check", "title": "每小时检查", "default_cron": "0 * * * *"}
  ],
  "ui": {
    "schema": {
      "type": "form",
      "title": "事件审计设置",
      "description": "选择审计输出方式并保存。事件订阅由插件能力声明管理。",
      "components": [
        {"type": "text", "bind": "label", "label": "显示标签", "placeholder": "例如：媒体归档", "description": "用于日志中区分这套审计配置。"},
        {"type": "select", "bind": "mode", "label": "审计详情", "default": "compact", "options": [
          {"label": "简要", "value": "compact"},
          {"label": "详细", "value": "detailed"}
        ]},
        {"type": "button", "id": "preview", "action": "preview", "label": "发送测试事件"}
      ]
    }
  }
}
